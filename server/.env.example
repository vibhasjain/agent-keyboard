# Agent Keyboard server — environment.
# Copy to server/.env for local dev; set the same values as Fly secrets in prod.
# The server exits at boot if any REQUIRED var is missing, naming it in the log.

# ─── Required ────────────────────────────────────────────────────────────────

# Supabase project base URL. Also injected into the served widget bundle.
SUPABASE_URL=

# Supabase publishable anon key. Public by design (RLS gates every write to the
# one allowed email); injected into the widget bundle at serve time.
SUPABASE_ANON_KEY=

# The email(s) allowed to drive the agent (case-insensitive; one, or a
# comma-separated few). Must match users created in Supabase (signups off).
# Users provisioned at runtime ("invite esther@example.com" from the bar) are
# additionally allow-listed via /data/agent-keyboard/allowed-emails.json.
ALLOWED_EMAIL=

# One-line JSON array allow-list of the repos the agent may edit. Each entry:
#   id         — slug used in the embed tag's data-site
#   repo       — https clone URL (GH_TOKEN is injected at clone/sync time)
#   branch     — the branch your host deploys from
#   domain     — bare host, no scheme (drives CORS + the "[Sent from …]" context)
#   pushBranch — OPTIONAL. Publish commits to this branch (a review branch) instead
#                of pushing straight to `branch`, so nothing deploys until you merge
#                it. Must differ from `branch`; a {ts} token becomes a UTC timestamp
#                (e.g. "agent-keyboard/{ts}" → a fresh branch per change).
# See sites.example.json for a pretty-printed multi-site example.
SITES=[{"id":"blog","repo":"https://github.com/you/blog.git","branch":"main","domain":"blog.example.com"}]

# Fine-grained GitHub PAT. Scope to ONLY the repos in SITES, permissions
# Contents: read/write + Metadata. Deliberately NO workflows permission — GitHub
# then rejects any push touching .github/workflows/, capping the agent's reach.
GH_TOKEN=

# ─── Claude Code CLI ─────────────────────────────────────────────────────────

# Consumed directly by the Claude Code CLI, never read by server code. Get it
# with `claude setup-token` (needs a Claude Pro/Max subscription). Boot warns if
# missing; the agent cannot run without it.
CLAUDE_CODE_OAUTH_TOKEN=

# ─── Optional ────────────────────────────────────────────────────────────────

# Extra pin to a specific Supabase user UUID, on top of ALLOWED_EMAIL.
ALLOWED_USER_ID=

# Supabase service_role key. Enables durable job history + re-attach. The bar
# works without it (boot warns); with it, jobs survive reloads and restarts.
SUPABASE_SERVICE_KEY=

# OpenAI key for voice dictation. The server mints short-lived realtime tokens;
# the key never reaches the browser. Absent = tapping the mic fails with a
# "voice not configured" error (the button itself is always shown).
OPENAI_API_KEY=

# Gemini key for the baked-in image-generation skill. Consumed by the skill
# script inside the CLI child (via process.env), never read by server code and
# never sent to the browser. Absent = the agent reports image generation as
# not configured on this deployment.
GEMINI_API_KEY=

# This server's public base URL. The provision-user skill points invite emails
# at $AK_PUBLIC_URL/welcome (add that URL to Supabase Auth → URL Configuration
# → Redirect URLs). Absent = invite links use the Supabase project's Site URL.
AK_PUBLIC_URL=

# App-scoped Fly deploy token (fly tokens create deploy -a <app>). Enables the
# self-ops skill: the agent can read its own logs/status and set secrets.
FLY_API_TOKEN=

# Supabase personal access token (NOT the service key). Lets the agent manage
# auth config (SMTP, email templates, redirect URLs) via the Management API.
SUPABASE_ACCESS_TOKEN=

# Resend API key (send permission is enough). Enables branded, site-named invite
# emails from your own domain; without it, provisioning uses Supabase's generic
# built-in mailer. Pair with EMAIL_FROM.
RESEND_API_KEY=

# Sender for branded invites. Must be a verified Resend domain.
EMAIL_FROM="Agent Keyboard <invites@agentkeyboard.com>"

# Comma-separated extra CORS origins (deploy previews, staging hosts). The site's
# own https://domain and https://www.domain are always allowed.
EXTRA_ORIGINS=

# ─── Tuning (sensible defaults; override only if needed) ─────────────────────

# Default model passed to the Claude Code CLI. Per-site overrides live in
# /data/agent-keyboard/sites/<id>/settings.json — the agent edits that file
# itself when you ask it to switch models ("switch to sonnet").
CLAUDE_MODEL=opus

# Context-window size used for the approximate "how much context is left?"
# gauge in the harness note and result frames.
CONTEXT_WINDOW_TOKENS=200000

# Per-run timeout in milliseconds.
CLAUDE_RUN_TIMEOUT_MS=900000

# Timeout for an on-demand "compact your memory" turn.
CLAUDE_COMPACT_TIMEOUT_MS=300000

# Path to the claude binary.
CLAUDE_BIN=claude

# Root for per-site checkouts + Claude session files (also HOME in the image).
AGENT_DATA_DIR=/data

# Override the path to the built widget.js served at GET /widget.js.
WIDGET_JS_PATH=

# HTTP port.
PORT=8080

# Commit identity for the agent's commits.
GIT_AUTHOR_NAME=Agent Keyboard
GIT_AUTHOR_EMAIL=agent@agentkeyboard.com
GIT_COMMITTER_NAME=Agent Keyboard
GIT_COMMITTER_EMAIL=agent@agentkeyboard.com

# OpenAI realtime transcription model. Default gpt-4o-transcribe — higher
# accuracy for push-to-talk prompts. Set gpt-4o-mini-transcribe for lower cost,
# or gpt-realtime-whisper if you explicitly want realtime Whisper behavior.
REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Set to 1 to use the fallback realtime session shape where the "transcription"
# session type is unavailable.
REALTIME_FALLBACK=
